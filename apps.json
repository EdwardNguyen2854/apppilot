[
  {
    "id": "file-preview",
    "name": "File Preview",
    "type": "web",
    "description": "Local file preview server for viewing documents, images, and other files in browser",
    "exe": "apps/file-preview/FilePreview.exe",
    "args": ["--port", "8787"],
    "port": 8787,
    "url": "http://127.0.0.1:8787",
    "health_url": "http://127.0.0.1:8787/health",
    "auto_start": true,
    "log_file": "logs/FilePreview.log",
    "monitor": {
      "process": true,
      "port": true,
      "http": true,
      "cpu_ram": true,
      "events": true
    }
  },
